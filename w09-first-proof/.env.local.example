# Copia este archivo a .env.local y llena los valores desde tu proyecto de
# Supabase (Project Settings > API). Nunca commitees .env.local ni pegues
# estas llaves en el chat/código — .env.local ya está en .gitignore.
#
# Estas son las claves "anon/public": están diseñadas para exponerse en el
# navegador. La seguridad real de los datos la da Row Level Security (ver
# sql/schema.sql), no el secreto de esta llave.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave real de la API de Anthropic — sin prefijo NEXT_PUBLIC_ porque nunca
# debe llegar al navegador. Solo se usa server-side en la Feature 3
# (observaciones descriptivas preparadas por IA). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Service role de Supabase (Project Settings > API > service_role). Se salta
# RLS: NUNCA con prefijo NEXT_PUBLIC_, nunca en el navegador. Solo la usa
# lib/supabase/admin.ts para escribir las observaciones de IA, que el
# candidato no puede escribir con la llave pública (Feature 3).
SUPABASE_SERVICE_ROLE_KEY=
