# Copia este archivo a .env.local y llena los valores desde tu proyecto
# Supabase ("semestre" > Project Settings > API). Nunca commitees .env.local
# ni pegues estas llaves en el chat/código — .env.local ya está en .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Flag temporal (ver README): mientras el proyecto Supabase "semestre" esté
# caído, deja esto en blanco o "false" — la app guarda en localStorage y NO
# necesita las variables de arriba. Ponlo en "true" solo cuando Supabase esté
# sano de nuevo y quieras volver a insertar ahí.
NEXT_PUBLIC_USAR_SUPABASE=
