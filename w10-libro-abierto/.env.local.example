# Copia este archivo a .env.local y llena los valores desde tu proyecto de
# Supabase (Project Settings > API). Nunca commitees .env.local ni pegues
# estas llaves en el chat/código — .env.local ya está en .gitignore.
#
# URL base del proyecto: https://xxxx.supabase.co — sin /rest/v1/, sin
# espacios, sin comillas.
NEXT_PUBLIC_SUPABASE_URL=
# Llave "anon/public": está diseñada para exponerse en el navegador. La
# seguridad real de los datos la da Row Level Security (sql/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave real de la API de Anthropic, sin prefijo NEXT_PUBLIC_: nunca llega
# al navegador. Solo la usa el auditor de IA en el servidor
# (lib/auditor.ts, Feature 5). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
